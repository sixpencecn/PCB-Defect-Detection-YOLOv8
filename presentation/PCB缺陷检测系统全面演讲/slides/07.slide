<Slide style={{ width: 1280, height: 720, background: '#FFFFFF', padding: 0, flexDirection: 'column' }}>
  <Box style={{ height: 72, width: '100%', background: '#1E4FA8', flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', padding: '0px 60px' }}>
    <Text style={{ fontSize: 30, fontWeight: 'bold', color: '#FFFFFF' }}>DeepPCB 数据集与六类工业缺陷</Text>
    <Text style={{ fontSize: 14, color: '#D9E6F7' }}>YOLOv8 · DeepPCB</Text>
  </Box>
  <Box style={{ height: 570, width: '100%', padding: '24px 60px 12px 60px', flexDirection: 'column', gap: 16 }}>
    <Text style={{ fontSize: 20, color: '#4A5568', lineHeight: 1.5 }}>数据集托管于 tangsanli5201/DeepPCB 开源仓库，标注为空格分隔文本，官方已给出训练与测试图像清单。</Text>
    <Box style={{ height: 422, flexDirection: 'row', gap: 28 }}>
      <Box style={{ width: 706, height: 422 }}>
        <Table
          style={{ width: '100%', height: '100%' }}
          defaultTextStyle={{ fontSize: 18, textAlign: 'center', color: '#1A2230' }}
          defaultCellStyle={{ border: { left: { width: 1, color: '#E5E7EB' }, right: { width: 1, color: '#E5E7EB' }, top: { width: 1, color: '#E5E7EB' }, bottom: { width: 1, color: '#E5E7EB' } } }}
          cells={[
            [{ text: '本项目 ID', textStyle: { bold: true, color: '#FFFFFF', fontSize: 18 }, cellStyle: { background: { color: '#1E4FA8' } } }, { text: '中文名称', textStyle: { bold: true, color: '#FFFFFF', fontSize: 18 }, cellStyle: { background: { color: '#1E4FA8' } } }, { text: '英文标签', textStyle: { bold: true, color: '#FFFFFF', fontSize: 18 }, cellStyle: { background: { color: '#1E4FA8' } } }, { text: '原始 ID', textStyle: { bold: true, color: '#FFFFFF', fontSize: 18 }, cellStyle: { background: { color: '#1E4FA8' } } }],
            ['0', '开路', 'open', '1'],
            [{ text: '1', cellStyle: { background: { color: '#F7F9FC' } } }, { text: '短路', cellStyle: { background: { color: '#F7F9FC' } } }, { text: 'short', cellStyle: { background: { color: '#F7F9FC' } } }, { text: '2', cellStyle: { background: { color: '#F7F9FC' } } }],
            ['2', '针孔', 'pinhole', '6'],
            [{ text: '3', cellStyle: { background: { color: '#F7F9FC' } } }, { text: '毛刺', cellStyle: { background: { color: '#F7F9FC' } } }, { text: 'burr (spur)', cellStyle: { background: { color: '#F7F9FC' } } }, { text: '4', cellStyle: { background: { color: '#F7F9FC' } } }],
            ['4', '鼠咬', 'mousebite', '3'],
            [{ text: '5', cellStyle: { background: { color: '#F7F9FC' } } }, { text: '伪铜', cellStyle: { background: { color: '#F7F9FC' } } }, { text: 'spurious_copper', cellStyle: { background: { color: '#F7F9FC' } } }, { text: '5', cellStyle: { background: { color: '#F7F9FC' } } }],
          ]}
        />
      </Box>
      <Box style={{ width: 426, height: 422, flexDirection: 'column', gap: 19 }}>
        <Box style={{ height: 128, background: '#F0F5FC', border: '1px solid #D6DCE5', padding: '16px 24px', flexDirection: 'column', justifyContent: 'center' }}>
          <Text style={{ fontSize: 48, fontWeight: 'bold', color: '#1E4FA8' }}>1500 <span style={{ fontSize: 20, color: '#4A5568' }}>张</span></Text>
          <Text style={{ fontSize: 18, color: '#4A5568' }}>640×640 PCB 图像</Text>
        </Box>
        <Box style={{ height: 128, background: '#F0F5FC', border: '1px solid #D6DCE5', padding: '16px 24px', flexDirection: 'column', justifyContent: 'center' }}>
          <Text style={{ fontSize: 48, fontWeight: 'bold', color: '#1E4FA8' }}>10113 <span style={{ fontSize: 20, color: '#4A5568' }}>个</span></Text>
          <Text style={{ fontSize: 18, color: '#4A5568' }}>六类缺陷标注框</Text>
        </Box>
        <Box style={{ height: 128, background: '#F0F5FC', border: '1px solid #D6DCE5', padding: '16px 24px', flexDirection: 'column', justifyContent: 'center' }}>
          <Text style={{ fontSize: 48, fontWeight: 'bold', color: '#1E4FA8' }}>1000 : 500</Text>
          <Text style={{ fontSize: 18, color: '#4A5568' }}>官方训练 / 测试划分</Text>
        </Box>
      </Box>
    </Box>
    <Box style={{ height: 50, background: '#E8EFF8', padding: '0px 24px', justifyContent: 'center' }}>
      <Text style={{ fontSize: 18, color: '#0E3F8C', fontWeight: 'bold' }}>类别映射已对齐需求：伪铜对应 spur、鼠咬对应 mousebite，避免论文与界面出现名称歧义</Text>
    </Box>
  </Box>
  <Box style={{ height: 78, width: '100%', padding: '10px 60px', flexDirection: 'row', justifyContent: 'space-between' }}>
    <Text style={{ fontSize: 14, color: '#8B97A8' }}>PCB Defect Detection · YOLOv8</Text>
    <Text style={{ fontSize: 14, color: '#1E4FA8' }}>07</Text>
  </Box>
</Slide>
